# ═══════════════════════════════════════════════════════════════════════
# Kayan AI Productions — Environment Variables
# Source of truth: this file is auto-reconciled with actual code usage.
# Last reconciled: KAYAN-FIX-09 (2026-09-27)
# ═══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────
# Primary app DB (PostgreSQL + Drizzle).
DATABASE_URL=postgresql://user:password@localhost:5432/kayan
# GPU job queue DB (can point to a separate DB or the same one).
QUEUE_DATABASE_URL=postgresql://user:password@localhost:5432/kayan

# ── Voice / TTS (Deepgram is the ONLY production voice provider) ──────
DEEPGRAM_API_KEY=
# Optional: override the Deepgram model (default: aura-asteria-en).
DEEPGRAM_TTS_MODEL=
# Legacy selector — kept because code reads it; only "deepgram" is supported.
VOICE_PROVIDER=deepgram

# ── GPU worker (KayanGPU over SSH tunnel to 127.0.0.1:8080) ────────────
GPU_WORKER_URL=http://127.0.0.1:8080
# Alias used by queue-worker.ts for the same endpoint (kept for compatibility).
VIDEO_WORKER_URL=http://127.0.0.1:8080
GPU_WORKER_TOKEN=
GPU_WORKER_TIMEOUT=3600000
# SSH access to the GPU instance (used for scp of produced videos).
GPU_SSH_KEY=/home/ubuntu/.ssh/kayan_gpu
GPU_SSH_TARGET=ubuntu@127.0.0.1
# Where the queue worker writes downloaded MP4s.
NASHASH_VIDEO_DIR=

# ── LLM / script generation ───────────────────────────────────────────
# Local GPU LLM (vLLM on the GPU instance, reached via SSH tunnel).
LLM_WORKER_URL=http://127.0.0.1:8082
KAYAN_LLM_URL=http://127.0.0.1:8082
# Provider selector for script generation (production: local-gpu).
LLM_PROVIDER=local-gpu

# ── Face detection (local Python venv on Nashash) ─────────────────────
KAYAN_FACE_PYTHON=/home/ubuntu/Nashash/.venvs/face/bin/python

# ── Optional env-file override ────────────────────────────────────────
# Explicit path to a .env file when running outside the standard layout.
KAYAN_ENV_FILE=

# ── Production API auth (Bearer token for /api/production, /api/video) ─
PRODUCTION_API_TOKEN=

# ── Polling ───────────────────────────────────────────────────────────
GPU_POLL_INTERVAL=3000
