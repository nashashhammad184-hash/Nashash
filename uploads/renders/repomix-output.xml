import { Router, type IRouter } from "express";
import { db, actorsTable, characterReferencesTable } from "@workspace/db";
import { ListActorsResponse } from "@workspace/api-zod";
import { eq } from "drizzle-orm";

const router: IRouter = Router();

// دالة فحص وتصحيح الروابط لضمان عدم استخدام روابط صفحات ImgBB الوهمية
function cleanImageUrl(url: string | null | undefined): string | null {
  if (!url) return null;
  const trimmed = url.trim();
  // إذا كان الرابط يؤدي إلى صفحة ImgBB وليس الصورة المباشرة
  if (trimmed.includes("ibb.co") && !trimmed.match(/\.(jpeg|jpg|gif|png|webp)$/i)) {
    // نرفض الروابط غير المباشرة لمنع الأخطاء ونعيدها null ليعرض التطبيق الـ Placeholder
    return null; 
  }
  return trimmed;
}

// 1. جلب قائمة الممثلين الأساسية مع تنظيف الروابط الوهمية ديناميكياً
router.get("/actors", async (req, res): Promise<void> => {
  const typeFilter = req.query["type"] as string | undefined;
  const categoryFilter = req.query["category"] as string | undefined;

  const actors = categoryFilter
    ? await db.select().from(actorsTable).where(eq(actorsTable.category, categoryFilter))
    : typeFilter
      ? await db.select().from(actorsTable).where(eq(actorsTable.type, typeFilter))
      : await db.select().from(actorsTable).orderBy(actorsTable.id);

  // معالجة البيانات لضمان أن الشخصيات 27 و 28 و 29 وأي رابط وهمي يعود كـ NULL
  const sanitizedActors = actors.map(actor => ({
    ...actor,
    imageUrl: [27, 28, 29].includes(actor.id) ? null : cleanImageUrl(actor.imageUrl)
  }));

  res.json(ListActorsResponse.parse(sanitizedActors));
});

// 2. [GET] جلب مراجع وصور شخصية معينة
router.get("/actors/:actorId/references", async (req, res): Promise<void> => {
  const actorId = parseInt(req.params.actorId, 10);
  if (isNaN(actorId)) {
    res.status(400).json({ error: "Invalid actorId" });
    return;
  }
  const refs = await db
    .select()
    .from(characterReferencesTable)
    .where(eq(characterReferencesTable.actorId, actorId))
    .orderBy(characterReferencesTable.id);
  res.json(refs);
});

// 3. [POST] إضافة صورة مرجعية جديدة للشخصية مع فحص الرابط المباشر
router.post("/actors/:actorId/references", async (req, res): Promise<void> => {
  const actorId = parseInt(req.params.actorId, 10);
  const { assetUrl, referenceType, isPrimary, projectId, metadata } = req.body;

  if (isNaN(actorId) || !assetUrl) {
    res.status(400).json({ error: "actorId and assetUrl are required" });
    return;
  }

  const sanitizedUrl = cleanImageUrl(assetUrl);
  if (!sanitizedUrl) {
    res.status(400).json({ error: "Direct Image URL is required. Do not use ibb.co page links." });
    return;
  }

  if (isPrimary) {
    await db
      .update(characterReferencesTable)
      .set({ isPrimary: false })
      .where(eq(characterReferencesTable.actorId, actorId));
  }

  const [newRef] = await db
    .insert(characterReferencesTable)
    .values({
      actorId,
      projectId: projectId ? parseInt(projectId, 10) : null,
      assetUrl: sanitizedUrl,
      referenceType: referenceType || "image",
      isPrimary: !!isPrimary,
      metadata: metadata || {},
    })
    .returning();

  res.status(201).json(newRef);
});

// 4. [DELETE] حذف صورة مرجعية
router.delete("/references/:id", async (req, res): Promise<void> => {
  const id = parseInt(req.params.id, 10);
  if (isNaN(id)) {
    res.status(400).json({ error: "Invalid reference id" });
    return;
  }
  await db.delete(characterReferencesTable).where(eq(characterReferencesTable.id, id));
  res.sendStatus(204);
});

// 5. [PATCH] تعيين صورة معينة كـ Primary
router.patch("/references/:id/primary", async (req, res): Promise<void> => {
  const id = parseInt(req.params.id, 10);
  if (isNaN(id)) {
    res.status(400).json({ error: "Invalid reference id" });
    return;
  }
  const [target] = await db.select().from(characterReferencesTable).where(eq(characterReferencesTable.id, id));
  if (!target) {
    res.status(404).json({ error: "Reference not found" });
    return;
  }
  await db.update(characterReferencesTable).set({ isPrimary: false }).where(eq(characterReferencesTable.actorId, target.actorId));
  const [updated] = await db.update(characterReferencesTable).set({ isPrimary: true }).where(eq(characterReferencesTable.id, id)).returning();
  res.json(updated);
});

export default router;
</file>

<file path="artifacts/api-server/src/routes/pipeline.ts">
import { Router, type IRouter, type Request, type Response } from "express";
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { spawn } from "node:child_process";
import { db, projectsTable, scriptsTable, shotsTable } from "@workspace/db";
import { eq, desc } from "drizzle-orm";
import { logger } from "../lib/logger";

const router: IRouter = Router();

export type PipelineStageName =
  | "project"
  | "script"
  | "shots"
  | "voice"
  | "video"
  | "lipsync"
  | "timeline"
  | "subtitles"
  | "render"
  | "final_mp4";

export type PipelineStageStatus = "pending" | "processing" | "completed" | "failed" | "skipped";

export interface PipelineStage {
  name: PipelineStageName;
  status: PipelineStageStatus;
  startedAt?: string;
  completedAt?: string;
  output?: Record<string, unknown> | string | null;
  error?: string | null;
}

export interface PipelineRun {
  id: string;
  projectId?: number;
  status: "pending" | "processing" | "completed" | "failed";
  progress: number;
  currentStage: PipelineStageName;
  stages: Record<PipelineStageName, PipelineStage>;
  outputUrl?: string;
  outputPath?: string;
  fileSize?: number;
  error?: string | null;
  createdAt: string;
  updatedAt: string;
  completedAt?: string;
}

const pipelineRunsStore = new Map<string, PipelineRun>();

const DEEPGRAM_TTS_ENDPOINT = "https://api.deepgram.com/v1/speak";
const REPLICATE_PREDICTIONS_ENDPOINT = "https://api.replicate.com/v1/predictions";
const HTTP_TIMEOUT_MS = 25_000;
const MAX_POLLING_ATTEMPTS = 60;
const POLLING_INTERVAL_MS = 3_000;

function getUploadsDir(sub: string): string {
  const dir = path.resolve(process.cwd(), "uploads", sub);
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
  return dir;
}

function initializeStages(): Record<PipelineStageName, PipelineStage> {
  const stageNames: PipelineStageName[] = [
    "project",
    "script",
    "shots",
    "voice",
    "video",
    "lipsync",
    "timeline",
    "subtitles",
    "render",
    "final_mp4",
  ];

  const stages: Partial<Record<PipelineStageName, PipelineStage>> = {};
  for (const name of stageNames) {
    stages[name] = {
      name,
      status: "pending",
    };
  }
  return stages as Record<PipelineStageName, PipelineStage>;
}

function extractMediaUrl(output: unknown): string | undefined {
  if (typeof output === "string" && output.trim().length > 0) return output.trim();
  if (Array.isArray(output) && output.length > 0 && typeof output[0] === "string") return output[0].trim();
  if (output && typeof output === "object") {
    const r = output as Record<string, unknown>;
    for (const k of ["video", "video_url", "url", "output", "synced_video"]) {
      if (typeof r[k] === "string" && (r[k] as string).trim().length > 0) return (r[k] as string).trim();
    }
  }
  return undefined;
}

async function pollReplicatePrediction(predictionId: string, apiToken: string): Promise<string> {
  const pollingUrl = `${REPLICATE_PREDICTIONS_ENDPOINT}/${predictionId}`;
  for (let attempt = 0; attempt < MAX_POLLING_ATTEMPTS; attempt++) {
    await new Promise((r) => setTimeout(r, POLLING_INTERVAL_MS));
    const response = await fetch(pollingUrl, {
      method: "GET",
      headers: { Authorization: `Bearer ${apiToken}`, "Content-Type": "application/json" },
      signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
    });

    if (!response.ok) {
      const txt = await response.text().catch(() => "");
      throw new Error(`Replicate polling failed (${response.status}): ${txt}`);
    }

    const json = (await response.json()) as { status: string; output?: unknown; error?: string | null };
    if (json.status === "succeeded") {
      const url = extractMediaUrl(json.output);
      if (!url) throw new Error("Replicate status was succeeded but returned no valid media URL.");
      return url;
    }
    if (json.status === "failed") throw new Error(`Replicate prediction failed: ${json.error || "Unknown error"}`);
    if (json.status === "canceled") throw new Error("Replicate prediction was canceled.");
  }
  throw new Error(`Replicate prediction timed out after ${MAX_POLLING_ATTEMPTS * 3} seconds.`);
}

async function executePipeline(pipeline: PipelineRun, payload: Record<string, any>): Promise<void> {
  const deepgramKey = process.env.DEEPGRAM_API_KEY?.trim();
  const replicateToken = process.env.REPLICATE_API_TOKEN?.trim();
  const videoVersion = process.env.REPLICATE_VIDEO_MODEL_VERSION?.trim();
  const lipsyncVersion = process.env.REPLICATE_LIPSYNC_MODEL_VERSION?.trim();

  const updateStage = (name: PipelineStageName, status: PipelineStageStatus, output?: any, error?: string) => {
    pipeline.currentStage = name;
    pipeline.stages[name].status = status;
    pipeline.updatedAt = new Date().toISOString();
    if (status === "processing") pipeline.stages[name].startedAt = new Date().toISOString();
    if (status === "completed") {
      pipeline.stages[name].completedAt = new Date().toISOString();
      if (output !== undefined) pipeline.stages[name].output = output;
    }
    if (status === "failed" && error) {
      pipeline.stages[name].error = error;
      pipeline.stages[name].completedAt = new Date().toISOString();
    }
  };

  try {
    pipeline.status = "processing";
    pipeline.progress = 5;

    // Stage 1: Project Verification
    updateStage("project", "processing");
    let projectTitle = payload.title || "Kayan AI Production";
    if (pipeline.projectId) {
      const [proj] = await db.select().from(projectsTable).where(eq(projectsTable.id, pipeline.projectId));
      if (!proj) throw new Error(`Project with ID ${pipeline.projectId} does not exist.`);
      projectTitle = proj.title;
    }
    updateStage("project", "completed", { title: projectTitle });
    pipeline.progress = 10;

    // Stage 2: Script
    updateStage("script", "processing");
    let scriptContent = payload.text || payload.script || "";
    if (!scriptContent && pipeline.projectId) {
      const [latestScript] = await db.select().from(scriptsTable).where(eq(scriptsTable.projectId, pipeline.projectId)).orderBy(desc(scriptsTable.createdAt));
      if (latestScript) scriptContent = latestScript.generatedContent;
    }
    if (!scriptContent) scriptContent = "In the heart of the ancient city, the story unfolds with cinematic grandeur.";
    updateStage("script", "completed", { scriptContent: scriptContent.slice(0, 120) });
    pipeline.progress = 20;

    // Stage 3: Shots
    updateStage("shots", "processing");
    const visualPrompt = payload.prompt || `Cinematic establishing shot of ${projectTitle}, dramatic lighting, 4k`;
    updateStage("shots", "completed", { visualPrompt });
    pipeline.progress = 30;

    // Stage 4: Voice (Deepgram TTS)
    updateStage("voice", "processing");
    if (!deepgramKey) throw new Error("DEEPGRAM_API_KEY is not configured.");
    const ttsModel = process.env.DEEPGRAM_TTS_MODEL?.trim() || "aura-asteria-en";
    const voiceRes = await fetch(`${DEEPGRAM_TTS_ENDPOINT}?model=${encodeURIComponent(ttsModel)}`, {
      method: "POST",
      headers: { Authorization: `Token ${deepgramKey}`, "Content-Type": "application/json" },
      body: JSON.stringify({ text: scriptContent }),
      signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
    });

    if (!voiceRes.ok) {
      const errText = await voiceRes.text().catch(() => "");
      throw new Error(`Deepgram TTS failed (${voiceRes.status}): ${errText}`);
    }

    const voiceBuffer = Buffer.from(await voiceRes.arrayBuffer());
    if (voiceBuffer.length === 0) throw new Error("Deepgram TTS returned 0 bytes.");
    const voicePath = path.join(getUploadsDir("audio"), `pipeline_voice_${pipeline.id}.mp3`);
    fs.writeFileSync(voicePath, voiceBuffer);
    const audioDataUri = `data:audio/mp3;base64,${voiceBuffer.toString("base64")}`;
    updateStage("voice", "completed", { audioPath: voicePath, sizeBytes: voiceBuffer.length });
    pipeline.progress = 45;

    // Stage 5: Video (Replicate Video Gen)
    updateStage("video", "processing");
    if (!replicateToken) throw new Error("REPLICATE_API_TOKEN is not configured.");
    if (!videoVersion) throw new Error("REPLICATE_VIDEO_MODEL_VERSION is not configured.");

    const videoCreateRes = await fetch(REPLICATE_PREDICTIONS_ENDPOINT, {
      method: "POST",
      headers: { Authorization: `Bearer ${replicateToken}`, "Content-Type": "application/json", Prefer: "wait=5" },
      body: JSON.stringify({ version: videoVersion, input: { prompt: visualPrompt } }),
      signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
    });

    if (!videoCreateRes.ok) {
      const errText = await videoCreateRes.text().catch(() => "");
      throw new Error(`Replicate Video creation failed (${videoCreateRes.status}): ${errText}`);
    }

    const videoPred = (await videoCreateRes.json()) as { id: string; status: string; output?: unknown };
    const rawVideoUrl = videoPred.status === "succeeded" ? extractMediaUrl(videoPred.output) || (await pollReplicatePrediction(videoPred.id, replicateToken)) : await pollReplicatePrediction(videoPred.id, replicateToken);
    updateStage("video", "completed", { rawVideoUrl });
    pipeline.progress = 60;

    // Stage 6: Lip Sync
    updateStage("lipsync", "processing");
    if (!lipsyncVersion) throw new Error("REPLICATE_LIPSYNC_MODEL_VERSION is not configured.");

    const lipCreateRes = await fetch(REPLICATE_PREDICTIONS_ENDPOINT, {
      method: "POST",
      headers: { Authorization: `Bearer ${replicateToken}`, "Content-Type": "application/json", Prefer: "wait=5" },
      body: JSON.stringify({
        version: lipsyncVersion,
        input: { face: rawVideoUrl, input_audio: audioDataUri },
      }),
      signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
    });

    if (!lipCreateRes.ok) {
      const errText = await lipCreateRes.text().catch(() => "");
      throw new Error(`Replicate LipSync failed (${lipCreateRes.status}): ${errText}`);
    }

    const lipPred = (await lipCreateRes.json()) as { id: string };
    const syncedVideoUrl = await pollReplicatePrediction(lipPred.id, replicateToken);
    updateStage("lipsync", "completed", { syncedVideoUrl });
    pipeline.progress = 75;

    // Stage 7: Timeline
    updateStage("timeline", "processing");
    updateStage("timeline", "completed", { activeClips: 1, order: "sequential" });
    pipeline.progress = 80;

    // Stage 8: Subtitles
    updateStage("subtitles", "processing");
    const srtContent = `1\n00:00:00,000 --> 00:00:05,000\n${scriptContent.slice(0, 80)}\n`;
    const srtPath = path.join(getUploadsDir("renders"), `subtitles_${pipeline.id}.srt`);
    fs.writeFileSync(srtPath, srtContent);
    updateStage("subtitles", "completed", { srtPath });
    pipeline.progress = 85;

    // Stage 9: Render & Final Assembly (FFmpeg)
    updateStage("render", "processing");
    const finalFileName = `final_${pipeline.id}.mp4`;
    const finalOutputPath = path.join(getUploadsDir("renders"), finalFileName);

    const tempVideoPath = path.join(getUploadsDir("temp"), `synced_temp_${pipeline.id}.mp4`);
    const vidDownRes = await fetch(syncedVideoUrl, { signal: AbortSignal.timeout(60_000) });
    if (!vidDownRes.ok) throw new Error("Failed to download synced video for final render.");
    fs.writeFileSync(tempVideoPath, Buffer.from(await vidDownRes.arrayBuffer()));

    await new Promise<void>((resolve, reject) => {
      const ffmpeg = spawn("ffmpeg", ["-y", "-i", tempVideoPath, "-c:v", "libx264", "-c:a", "aac", "-pix_fmt", "yuv420p", finalOutputPath]);
      let errLog = "";
      ffmpeg.stderr.on("data", (d) => (errLog += d.toString()));
      ffmpeg.on("close", (code) => {
        if (code === 0) resolve();
        else reject(new Error(`FFmpeg final assembly failed with code ${code}: ${errLog.slice(-300)}`));
      });
      ffmpeg.on("error", (err) => reject(new Error(`Failed to spawn FFmpeg: ${err.message}`)));
    });

    updateStage("render", "completed", { outputPath: finalOutputPath });
    pipeline.progress = 95;

    // Stage 10: Final MP4 Verification
    updateStage("final_mp4", "processing");
    if (!fs.existsSync(finalOutputPath)) throw new Error("Final MP4 file does not exist on disk.");
    const finalStats = fs.statSync(finalOutputPath);
    if (!finalStats.isFile() || finalStats.size === 0) throw new Error("Final MP4 file is 0 bytes.");

    updateStage("final_mp4", "completed", { fileSize: finalStats.size, filename: finalFileName });

    // Pipeline Complete!
    pipeline.status = "completed";
    pipeline.progress = 100;
    pipeline.outputPath = finalOutputPath;
    pipeline.outputUrl = `/uploads/renders/${finalFileName}`;
    pipeline.fileSize = finalStats.size;
    pipeline.completedAt = new Date().toISOString();
    pipeline.error = null;

    logger.info({ pipelineId: pipeline.id, fileSize: finalStats.size }, "Pipeline completed successfully");
  } catch (error) {
    const msg = error instanceof Error ? error.message : "Pipeline execution failed";
    updateStage(pipeline.currentStage, "failed", null, msg);
    pipeline.status = "failed";
    pipeline.error = msg;
    pipeline.completedAt = new Date().toISOString();
    logger.error({ pipelineId: pipeline.id, failedStage: pipeline.currentStage, err: msg }, "Pipeline execution halted due to stage failure");
  }
}

// 1. Start pipeline run
router.post(["/", "/start", "/run"], (req: Request, res: Response): void => {
  const payload = req.body || {};
  const pipelineId = `pipe_${Date.now()}_${crypto.randomBytes(4).toString("hex")}`;
  const projectId = payload.projectId ? Number(payload.projectId) : undefined;

  const pipeline: PipelineRun = {
    id: pipelineId,
    projectId,
    status: "pending",
    progress: 0,
    currentStage: "project",
    stages: initializeStages(),
    createdAt: new Date().toISOString(),
    updatedAt: new Date().toISOString(),
  };

  pipelineRunsStore.set(pipelineId, pipeline);

  setImmediate(() => {
    void executePipeline(pipeline, payload);
  });

  res.status(202).json({
    success: true,
    pipelineId: pipeline.id,
    status: pipeline.status,
    progress: pipeline.progress,
    currentStage: pipeline.currentStage,
    stages: pipeline.stages,
  });
});

// 2. List all pipeline runs (must be placed before /:id parameter route)
router.get(["/list", "/all"], (_req: Request, res: Response): void => {
  res.status(200).json({
    total: pipelineRunsStore.size,
    runs: Array.from(pipelineRunsStore.values()),
  });
});

// 3. Query granular status of a specific pipeline run by ID
router.get(["/status/:id", "/:id/status", "/:id"], (req: Request, res: Response): void => {
  const pipelineId = req.params["id"] as string;
  const pipeline = pipelineRunsStore.get(pipelineId);

  if (!pipeline) {
    res.status(404).json({ error: `Pipeline run with ID ${pipelineId} not found.` });
    return;
  }

  res.status(200).json(pipeline);
});

export default router;
</file>

<file path="artifacts/api-server/src/routes/render.ts">
import { Router, type IRouter, type Request, type Response } from "express";
import fs from "node:fs";
import path from "node:path";
import { logger } from "../lib/logger";

const router: IRouter = Router();

const DEEPGRAM_TTS_ENDPOINT = "https://api.deepgram.com/v1/speak";
const REPLICATE_PREDICTIONS_ENDPOINT = "https://api.replicate.com/v1/predictions";
const DEFAULT_TTS_MODEL = "aura-asteria-en";
const MAX_POLLING_ATTEMPTS = 80;
const POLLING_INTERVAL_MS = 3_000;
const HTTP_TIMEOUT_MS = 25_000;

interface ReplicatePrediction {
  id: string;
  version?: string;
  status: "starting" | "processing" | "succeeded" | "failed" | "canceled";
  error?: string | null;
  output?: unknown;
  urls?: {
    get?: string;
    cancel?: string;
  };
}

function extractMediaUrl(output: unknown): string | undefined {
  if (typeof output === "string" && output.trim().length > 0) {
    return output.trim();
  }
  if (Array.isArray(output) && output.length > 0) {
    const first = output[0];
    if (typeof first === "string" && first.trim().length > 0) {
      return first.trim();
    }
  }
  if (output && typeof output === "object") {
    const record = output as Record<string, unknown>;
    for (const key of ["video", "video_url", "url", "output", "synced_video"]) {
      const val = record[key];
      if (typeof val === "string" && val.trim().length > 0) {
        return val.trim();
      }
    }
  }
  return undefined;
}

function getRendersDir(): string {
  const rendersDir = path.resolve(process.cwd(), "uploads", "renders");
  if (!fs.existsSync(rendersDir)) {
    fs.mkdirSync(rendersDir, { recursive: true });
  }
  return rendersDir;
}

/**
 * 1. Deepgram TTS Stage
 */
async function generateAudioStage(text: string, deepgramKey: string, ttsModel: string): Promise<{ audioBuffer: Buffer; audioDataUri: string; audioPath: string }> {
  const url = `${DEEPGRAM_TTS_ENDPOINT}?model=${encodeURIComponent(ttsModel)}`;
  const response = await fetch(url, {
    method: "POST",
    headers: {
      Authorization: `Token ${deepgramKey}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ text }),
    signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
  });

  if (!response.ok) {
    const errorText = await response.text().catch(() => "");
    throw new Error(`Deepgram TTS failed (${response.status}): ${errorText}`);
  }

  const arrayBuffer = await response.arrayBuffer();
  const buffer = Buffer.from(arrayBuffer);

  if (!buffer || buffer.length === 0) {
    throw new Error("Deepgram TTS returned 0 bytes of audio data.");
  }

  const timestamp = Date.now();
  const audioFileName = `render_audio_${timestamp}.mp3`;
  const audioPath = path.join(getRendersDir(), audioFileName);
  fs.writeFileSync(audioPath, buffer);

  const audioDataUri = `data:audio/mp3;base64,${buffer.toString("base64")}`;
  return { audioBuffer: buffer, audioDataUri, audioPath };
}

/**
 * 2. Replicate Video Generation Stage
 */
async function generateVideoStage(prompt: string, replicateToken: string, videoModelVersion: string): Promise<string> {
  const createResponse = await fetch(REPLICATE_PREDICTIONS_ENDPOINT, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${replicateToken}`,
      "Content-Type": "application/json",
      Prefer: "wait=5",
    },
    body: JSON.stringify({
      version: videoModelVersion,
      input: { prompt },
    }),
    signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
  });

  if (!createResponse.ok) {
    const errorText = await createResponse.text().catch(() => "");
    throw new Error(`Replicate Video API returned HTTP ${createResponse.status}: ${errorText}`);
  }

  let prediction = (await createResponse.json()) as ReplicatePrediction;
  if (!prediction || !prediction.id) {
    throw new Error("Replicate Video API did not return a valid prediction ID.");
  }

  const pollingUrl = prediction.urls?.get || `${REPLICATE_PREDICTIONS_ENDPOINT}/${prediction.id}`;

  for (let attempt = 0; attempt < MAX_POLLING_ATTEMPTS; attempt++) {
    if (prediction.status === "succeeded") {
      const videoUrl = extractMediaUrl(prediction.output);
      if (!videoUrl) {
        throw new Error("Replicate Video succeeded but returned no valid video URL.");
      }
      return videoUrl;
    }

    if (prediction.status === "failed") {
      throw new Error(`Replicate Video prediction failed: ${prediction.error || "Unknown error"}`);
    }

    if (prediction.status === "canceled") {
      throw new Error("Replicate Video prediction was canceled.");
    }

    await new Promise((resolve) => setTimeout(resolve, POLLING_INTERVAL_MS));

    const pollResponse = await fetch(pollingUrl, {
      method: "GET",
      headers: {
        Authorization: `Bearer ${replicateToken}`,
        "Content-Type": "application/json",
      },
      signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
    });

    if (!pollResponse.ok) {
      const pollErrorText = await pollResponse.text().catch(() => "");
      throw new Error(`Replicate Video polling failed (${pollResponse.status}): ${pollErrorText}`);
    }

    prediction = (await pollResponse.json()) as ReplicatePrediction;
  }

  throw new Error(`Replicate Video generation timed out after ${MAX_POLLING_ATTEMPTS * 3} seconds.`);
}

/**
 * 3. Replicate Lip Sync Stage
 */
async function generateLipSyncStage(videoUrl: string, audioDataUriOrUrl: string, replicateToken: string, lipsyncModelVersion: string): Promise<string> {
  const createResponse = await fetch(REPLICATE_PREDICTIONS_ENDPOINT, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${replicateToken}`,
      "Content-Type": "application/json",
      Prefer: "wait=5",
    },
    body: JSON.stringify({
      version: lipsyncModelVersion,
      input: {
        face: videoUrl,
        input_audio: audioDataUriOrUrl,
      },
    }),
    signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
  });

  if (!createResponse.ok) {
    const errorText = await createResponse.text().catch(() => "");
    throw new Error(`Replicate LipSync API returned HTTP ${createResponse.status}: ${errorText}`);
  }

  let prediction = (await createResponse.json()) as ReplicatePrediction;
  if (!prediction || !prediction.id) {
    throw new Error("Replicate LipSync API did not return a valid prediction ID.");
  }

  const pollingUrl = prediction.urls?.get || `${REPLICATE_PREDICTIONS_ENDPOINT}/${prediction.id}`;

  for (let attempt = 0; attempt < MAX_POLLING_ATTEMPTS; attempt++) {
    if (prediction.status === "succeeded") {
      const syncedUrl = extractMediaUrl(prediction.output);
      if (!syncedUrl) {
        throw new Error("Replicate LipSync succeeded but returned no valid video URL.");
      }
      return syncedUrl;
    }

    if (prediction.status === "failed") {
      throw new Error(`Replicate LipSync prediction failed: ${prediction.error || "Unknown error"}`);
    }

    if (prediction.status === "canceled") {
      throw new Error("Replicate LipSync prediction was canceled.");
    }

    await new Promise((resolve) => setTimeout(resolve, POLLING_INTERVAL_MS));

    const pollResponse = await fetch(pollingUrl, {
      method: "GET",
      headers: {
        Authorization: `Bearer ${replicateToken}`,
        "Content-Type": "application/json",
      },
      signal: AbortSignal.timeout(HTTP_TIMEOUT_MS),
    });

    if (!pollResponse.ok) {
      const pollErrorText = await pollResponse.text().catch(() => "");
      throw new Error(`Replicate LipSync polling failed (${pollResponse.status}): ${pollErrorText}`);
    }

    prediction = (await pollResponse.json()) as ReplicatePrediction;
  }

  throw new Error(`Replicate LipSync timed out after ${MAX_POLLING_ATTEMPTS * 3} seconds.`);
}

async function handleRenderPipeline(req: Request, res: Response): Promise<void> {
  const deepgramKey = process.env.DEEPGRAM_API_KEY?.trim();
  if (!deepgramKey) {
    res.status(500).json({ error: "DEEPGRAM_API_KEY environment variable is not configured." });
    return;
  }

  const replicateToken = process.env.REPLICATE_API_TOKEN?.trim();
  if (!replicateToken) {
    res.status(500).json({ error: "REPLICATE_API_TOKEN environment variable is not configured." });
    return;
  }

  const videoModelVersion = process.env.REPLICATE_VIDEO_MODEL_VERSION?.trim();
  if (!videoModelVersion) {
    res.status(500).json({ error: "REPLICATE_VIDEO_MODEL_VERSION environment variable is not configured." });
    return;
  }

  const lipsyncModelVersion = process.env.REPLICATE_LIPSYNC_MODEL_VERSION?.trim();
  if (!lipsyncModelVersion) {
    res.status(500).json({ error: "REPLICATE_LIPSYNC_MODEL_VERSION environment variable is not configured." });
    return;
  }

  const { prompt, text } = req.body || {};
  if (!prompt || !text) {
    res.status(400).json({ error: "Both 'prompt' (for video) and 'text' (for speech) are required." });
    return;
  }

  const ttsModel = process.env.DEEPGRAM_TTS_MODEL?.trim() || req.body?.model?.trim() || DEFAULT_TTS_MODEL;

  try {
    logger.info("==> [RENDER PIPELINE] Starting Stage 1: Deepgram TTS...");
    const { audioDataUri, audioPath } = await generateAudioStage(text, deepgramKey, ttsModel);

    logger.info("==> [RENDER PIPELINE] Starting Stage 2: Replicate Video Generation...");
    const rawVideoUrl = await generateVideoStage(prompt, replicateToken, videoModelVersion);

    logger.info("==> [RENDER PIPELINE] Starting Stage 3: Replicate Lip Sync...");
    const syncedVideoUrl = await generateLipSyncStage(rawVideoUrl, audioDataUri, replicateToken, lipsyncModelVersion);

    res.status(200).json({
      success: true,
      status: "completed",
      videoUrl: rawVideoUrl,
      syncedVideoUrl,
      renderUrl: syncedVideoUrl,
      stages: {
        audio: "completed",
        video: "completed",
        lipsync: "completed",
      },
    });
  } catch (error) {
    logger.error({ err: error }, "Render Pipeline failed");
    res.status(502).json({
      success: false,
      error: "Render Pipeline execution failed",
      message: error instanceof Error ? error.message : "Unknown pipeline error",
    });
  }
}

// Register render routes
router.post("/", handleRenderPipeline);
router.post("/merge", handleRenderPipeline);
router.post("/generate", handleRenderPipeline);

export default router;
</file>

