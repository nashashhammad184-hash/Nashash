<file path="artifacts/studio/src/components/project/tabs/production.tsx">
import React, { useEffect, useState } from 'react';

interface TimelineTrack {
  clipId: string;
  shotId: string;
  mediaUrl: string;
  startTime: number;
  endTime: number;
  duration: number;
  sequence: number;
}

interface ProductionTabProps {
  projectId: string;
}

const ProductionTab: React.FC<ProductionTabProps> = ({ projectId }) => {
  const [tracks, setTracks] = useState<TimelineTrack[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    if (!projectId) return;

    setLoading(true);
    setError(null);

    fetch(`/api/pipeline/auto-edit-status?projectId=${encodeURIComponent(projectId)}`)
      .then((res) => {
        if (!res.ok) throw new Error(`Server returned status code: ${res.status}`);
        return res.json();
      })
      .then((data) => {
        if (data.success && data.timelineTracks && data.timelineTracks.length > 0) {
          setTracks(data.timelineTracks);
        } else {
          setError('No real compiled timeline data exists for this project. Please run Auto Edit first.');
        }
      })
      .catch((err: any) => {
        setError(`Failed to compile real timeline: ${err.message}`);
      })
      .finally(() => {
        setLoading(false);
      });
  }, [projectId]);

  if (loading) return <div className="p-6 text-center text-gray-500">Compiling Production Tracks...</div>;
  if (error) return <div className="p-6 text-center text-red-500 font-semibold">⚠️ {error}</div>;

  return (
    <div className="p-6 bg-slate-900 text-white rounded-lg">
      <h2 className="text-xl font-bold mb-4">Production Timeline Tracks</h2>
      <div className="relative w-full overflow-x-auto bg-slate-950 p-4 rounded border border-slate-800">
        <div className="flex space-x-2 min-w-max">
          {tracks.map((track) => (
            <div 
              key={track.clipId} 
              className="bg-indigo-600 border border-indigo-400 p-3 rounded text-sm text-center shadow-md"
              style={{ width: `${Math.max(track.duration * 25, 120)}px` }}
            >
              <div className="font-bold truncate">Shot ID: {track.shotId}</div>
              <div className="text-xs text-indigo-200">{track.startTime.toFixed(1)}s - {track.endTime.toFixed(1)}s</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};

// QA EXPORT FIX: Change to default export to match strict rollup bundle specifications in project-detail.tsx
export default ProductionTab;
