      tags: [clips]
      summary: Delete a clip
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "204":
          description: Deleted

  /studio/stats:
    get:
      operationId: getStudioStats
      tags: [studio]
      summary: Get overall studio statistics
      responses:
        "200":
          description: Studio stats
          content:
            application/json:
