import { useEffect, useMemo, useState, useRef } from "react";
import {
  EditClip, Project, useListProjectClips, useCreateClip, useDeleteClip, useUpdateClip,
  getListProjectClipsQueryKey
} from "@workspace/api-client-react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import {
  Loader2, Plus, Film, Scissors, GripVertical, Trash2, Clock, Shield,
  Sparkles, CheckCircle2, AudioLines, WandSparkles, Music, Radio, AlignLeft, Download
} from "lucide-react";
import { useQueryClient } from "@tanstack/react-query";
import { toast } from "sonner";
import { motion } from "framer-motion";

const STUDIO_BRAND = "KAYAN AI PRODUCTIONS";

function KayanWatermark({ corner = "top-right" }: { corner?: "top-right" | "top-left" }) {
  const posClass = corner === "top-right" ? "top-2 right-2" : "top-2 left-2";
  return (
    <div className={`absolute ${posClass} z-10 pointer-events-none select-none`}>
      <div className="flex items-center gap-1 px-2 py-0.5 rounded-sm bg-black/50 backdrop-blur-[2px] border border-white/10">
        <Shield className="w-2 h-2 text-primary/70" />
        <span className="text-[8px] font-mono text-white/40 tracking-wide leading-none uppercase">
          PRODUCED BY KAYAN AI
        </span>
      </div>
    </div>
  );
}

function TimelinePreviewArea({
  totalDuration,
  clips,
  selectedClip,
  project,
}: {
  totalDuration: number;
  clips: any[];
  selectedClip?: any;
  project: Project;
}) {
  const [renderJobId, setRenderJobId] = useState<string | null>(null);
  const [renderStatus, setRenderStatus] = useState<"IDLE" | "QUEUED" | "PROCESSING" | "COMPLETED" | "FAILED">("IDLE");
  const [renderProgress, setRenderProgress] = useState(0);
  const [finalMp4Url, setFinalMp4Url] = useState<string | null>(null);
  const [renderError, setVideoError] = useState<string | null>(null);

  const formatTime = (s: number) => `${Math.floor(s / 60)}:${String(Math.round(s % 60)).padStart(2, "0")}`;
  
  const videoTracks = clips.filter(c => c.trackType === "video" || !c.trackType);
  const voiceTracks = clips.filter(c => c.trackType === "voice");
  const musicTracks = clips.filter(c => c.trackType === "music");
  const sfxTracks = clips.filter(c => c.trackType === "sfx");
  const subtitleTracks = clips.filter(c => c.trackType === "subtitle");

  const handleStartFinalRender = async () => {
    if (renderStatus === "QUEUED" || renderStatus === "PROCESSING") return;
    setRenderStatus("QUEUED");
    setRenderProgress(0);
    setFinalMp4Url(null);
    setVideoError(null);

    try {
      const response = await fetch(`/api/projects/${project.id}/render/start`, {
        method: "POST",
        headers: { "Content-Type": "application/json" }
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.error || "فشلت تهيئة عملية الرندرة.");
      setRenderJobId(data.jobId);
      setRenderStatus(data.status);
      toast.info("تمت جدولة مهمة التصدير النهائي على السيرفر (QUEUED)");
    } catch (err: any) {
      setRenderStatus("FAILED");
      setVideoError(err.message);
      toast.error(err.message);
    }
  };

  useEffect(() => {
    if (!renderJobId || renderStatus === "COMPLETED" || renderStatus === "FAILED") return undefined;
    let isMounted = true;
    const checkStatus = async () => {
      try {
        const response = await fetch(`/api/render/status/${renderJobId}`);
        const data = await response.json();
        if (isMounted && data.success) {
          setRenderStatus(data.status);
          setRenderProgress(data.progress ?? 0);
          if (data.status === "COMPLETED") {
            setFinalMp4Url(data.outputUrl);
            setRenderJobId(null);
            toast.success("اكتمل الـ Final Render الحقيقي! ملف الـ MP4 جاهز.");
          } else if (data.status === "FAILED") {
            setVideoError(data.error || "فشلت عملية معالجة أصول الفيلم.");
            setRenderJobId(null);
          }
        }
      } catch (err) {
        if (isMounted) {
          setRenderStatus("FAILED");
          setRenderJobId(null);
        }
      }
    };
    const interval = setInterval(checkStatus, 1500);
    return () => { isMounted = false; clearInterval(interval); };
  }, [renderJobId, renderStatus]);

  return (
    <div className="relative rounded-xl overflow-hidden border border-white/8 bg-black/60 p-4 mb-4">
      <KayanWatermark corner="top-right" />
      <div className="mb-4 flex flex-col sm:flex-row sm:items-center justify-between border-b border-white/5 pb-3 gap-2">
        <div className="inline-flex items-center gap-2 text-xs font-mono text-white/50 uppercase tracking-wider">
          <Film className="w-3.5 h-3.5 text-primary" />
          مخطط المسارات والإنتاج النهائي (Timeline & Final Render)
        </div>
        <div className="flex items-center gap-3">
          <div className="text-sm font-mono text-primary font-bold">إجمالي: {formatTime(totalDuration)}</div>
          <Button
            type="button"
            size="sm"
            onClick={handleStartFinalRender}
            disabled={renderStatus === "QUEUED" || renderStatus === "PROCESSING" || clips.length === 0}
            className="h-8 gap-1.5 bg-red-600 text-white font-bold hover:bg-red-500 shadow-[0_0_15px_rgba(220,38,38,0.25)] text-xs rounded"
          >
            {renderStatus === "QUEUED" || renderStatus === "PROCESSING" ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Sparkles className="w-3.5 h-3.5" />}
            Final Render
          </Button>
        </div>
      </div>

      {renderStatus !== "IDLE" && (
        <div className="mb-4 p-3 rounded-lg border bg-black/40 border-white/5 space-y-2">
          <div className="flex justify-between items-center text-[11px] font-mono">
            <span className="text-white/60">حالة الخادم: <strong className="text-primary">{renderStatus}</strong></span>
            <span className="text-primary font-bold">{renderProgress}%</span>
          </div>
          <div className="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
            <div className="h-full bg-primary transition-all duration-300" style={{ width: `${renderProgress}%` }} />
          </div>
          {renderError && <p className="text-[10px] text-red-500 font-mono">خطأ: {renderError}</p>}
          {finalMp4Url && (
            <div className="pt-2 flex flex-col gap-2">
              <video src={finalMp4Url} controls className="w-full rounded border border-white/10 bg-black max-h-48" preload="auto" />
              <a
                href={`/api/video/download?url=${encodeURIComponent(finalMp4Url)}`}
                download="final-kayan-production.mp4"
                className="inline-flex h-8 items-center justify-center gap-2 rounded bg-primary text-xs font-bold text-white hover:bg-primary/90 font-mono"
              >
                <Download className="w-3.5 h-3.5" /> DOWNLOAD FINAL MP4
              </a>
            </div>
          )}
        </div>
      )}

      <div className="space-y-3 font-mono text-xs opacity-75">
        <div className="grid grid-cols-6 items-center gap-2 bg-white/2 p-2 rounded border border-white/5">
          <span className="col-span-1 text-white/60 flex items-center gap-1"><Film className="w-3 h-3 text-blue-400" /> VIDEO</span>
          <div className="col-span-5 bg-blue-500/10 border border-blue-500/30 rounded p-1 text-[10px] text-blue-300 truncate">{videoTracks.length > 0 ? `${videoTracks.length} أصول مرئية` : "فارغ"}</div>
        </div>
        <div className="grid grid-cols-6 items-center gap-2 bg-white/2 p-2 rounded border border-white/5">
          <span className="col-span-1 text-white/60 flex items-center gap-1"><AudioLines className="w-3 h-3 text-green-400" /> VOICE</span>
          <div className="col-span-5 bg-green-500/10 border border-green-500/30 rounded p-1 text-[10px] text-green-300 truncate">{voiceTracks.length > 0 ? `${voiceTracks.length} حوارات Deepgram` : "فارغ"}</div>
        </div>
        <div className="grid grid-cols-6 items-center gap-2 bg-white/2 p-2 rounded border border-white/5">
          <span className="col-span-1 text-white/60 flex items-center gap-1"><Music className="w-3 h-3 text-purple-400" /> MUSIC</span>
          <div className="col-span-5 bg-purple-500/10 border border-purple-500/30 rounded p-1 text-[10px] text-purple-300 truncate">{musicTracks.length > 0 ? `${musicTracks.length} مسارات موسيقى` : "فارغ"}</div>
        </div>
        <div className="grid grid-cols-6 items-center gap-2 bg-white/2 p-2 rounded border border-white/5">
          <span className="col-span-1 text-white/60 flex items-center gap-1"><Radio className="w-3 h-3 text-amber-400" /> SFX</span>
