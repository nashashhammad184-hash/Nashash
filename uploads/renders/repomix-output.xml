import "dotenv/config";
import express from "express";
import path from "node:path";
import fs from "node:fs";
import router from "./routes/index";
import { logger } from "./lib/logger";

const app = express();
const port = process.env.PORT || 3000;

// تأمين وتوحيد جذر التخزين والمجلدات الفرعية للإنتاج حقيقياً عند الإقلاع
const STORAGE_ROOT = path.resolve(process.cwd(), "uploads");
const REQUIRED_DIRECTORIES = [
  path.join(STORAGE_ROOT, "audio"),
  path.join(STORAGE_ROOT, "renders"),
  path.join(STORAGE_ROOT, "temp")
];

REQUIRED_DIRECTORIES.forEach((dir) => {
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
});

app.use(express.json());

// تقديم الأصول والوسائط الحية من الجذر الموحد للتخزين
app.use("/uploads", express.static(STORAGE_ROOT));

// مسارات الـ API المركزية
app.use("/api", router);

// بث ملفات الواجهة الرسومية الثابتة للـ Studio من المنفذ 3000 مباشرة لحل مشكلة جدار الحماية
const studioPublicPath = path.resolve(process.cwd(), "artifacts/studio/dist/public");
app.use(express.static(studioPublicPath));

// توجيه كافة الطلبات الخارجية لعرض لوحة المخرج الرسومية فوراً لـ Single Page Application
