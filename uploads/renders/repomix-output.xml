import { Router, type IRouter, type Request, type Response } from "express";
import { Readable } from "node:stream";
import * as path from "node:path";
import * as fs from "node:fs/promises";
import { fileURLToPath } from "node:url";

const router: IRouter = Router();

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const PUBLIC_DIST_DIR = path.resolve(__dirname, "../../../studio/dist/public");
const UPLOADS_DIR = path.join(PUBLIC_DIST_DIR, "uploads/audio");

async function ensureUploadsDirectory() {
  try {
    await fs.mkdir(UPLOADS_DIR, { recursive: true });
  } catch (error) {
    // Directory already exists or handled by runtime
  }
}

router.post("/voice/generate", async (req: Request, res: Response): Promise<void> => {
  const { text, voiceId } = req.body;

  if (!text || typeof text !== "string" || text.trim().length === 0) {
    res.status(400).json({ error: "Text prompt is required and must be a valid string." });
    return;
  }

  const deepgramApiKey = process.env.DEEPGRAM_API_KEY?.trim() || "24e5b64ab8d3f195b80da40375e4009b0d22aede";
  const deepgramModel = process.env.DEEPGRAM_VOICE_MODEL?.trim() || "aura-asteria-en";

  if (!deepgramApiKey) {
    res.status(500).json({ 
      error: "Configuration Error", 
      message: "DEEPGRAM_API_KEY environment variable is not defined on the server." 
    });
    return;
  }

  try {
    await ensureUploadsDirectory();

    const deepgramUrl = `https://deepgram.com{encodeURIComponent(deepgramModel)}`;
    
    const apiResponse = await fetch(deepgramUrl, {
      method: "POST",
      headers: {
        "Authorization": `Token ${deepgramApiKey}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ text }),
    });

    if (!apiResponse.ok) {
      const errorDetails = await apiResponse.text().catch(() => "");
      res.status(502).json({
        error: "Deepgram TTS upstream failure",
        message: `Deepgram API returned status ${apiResponse.status}: ${errorDetails}`
      });
      return;
    }

    if (!apiResponse.body) {
      res.status(502).json({ error: "Deepgram TTS failure", message: "Deepgram returned an empty response body." });
      return;
    }

    const filename = `voice-${Date.now()}-${Math.random().toString(36).substring(7)}.mp3`;
    const filePath = path.join(UPLOADS_DIR, filename);

    const nodeStream = Readable.fromWeb(apiResponse.body as any);
    const fileWriteStream = fs.createWriteStream(filePath);
    
    await new Promise<void>((resolve, reject) => {
      nodeStream.pipe(fileWriteStream);
      fileWriteStream.on("finish", () => resolve());
      fileWriteStream.on("error", (err) => reject(err));
    });

    const fileStats = await fs.stat(filePath);
    if (!fileStats || fileStats.size === 0) {
      await fs.unlink(filePath).catch(() => {});
      res.status(500).json({ error: "Validation failure", message: "Generated audio file is empty or missing from disk." });
      return;
    }

    const audioUrl = `/uploads/audio/${filename}`;

    res.status(201).json({
      success: true,
      text,
      voiceId: voiceId || deepgramModel,
      audioUrl,
      fileSize: fileStats.size
    });

  } catch (error) {
    req.log?.error?.({ err: error }, "Deepgram TTS integration crash");
    res.status(500).json({
      error: "Internal server error",
      message: error instanceof Error ? error.message : "Unknown error processing audio stream"
    });
  }
});

export default router;
</file>

