openapi: 3.1.0
info:
  # Do not change the title, if the title changes, the import paths will be broken
  title: Api
  version: 0.1.0
  description: AI Production Studio API
servers:
  - url: /api
    description: Base API path
tags:
  - name: health
    description: Health operations
  - name: actors
    description: Digital actors
  - name: worlds
    description: Cinema worlds
  - name: projects
    description: Studio projects
  - name: scripts
    description: Cinematic scripts
  - name: shots
    description: Shot lists
  - name: tasks
    description: Production tasks
  - name: clips
    description: Edit room clips
  - name: studio
    description: Studio statistics
paths:
  /healthz:
    get:
      operationId: healthCheck
      tags: [health]
      summary: Health check
      responses:
        "200":
          description: Healthy
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HealthStatus"

  /actors:
    get:
      operationId: listActors
      tags: [actors]
      summary: List all digital actors
      parameters:
        - name: type
          in: query
          schema:
            type: string
      responses:
        "200":
          description: List of actors
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Actor"

  /worlds:
    get:
      operationId: listWorlds
      tags: [worlds]
      summary: List all cinema worlds
      responses:
        "200":
          description: List of worlds
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/World"

  /projects:
    get:
      operationId: listProjects
      tags: [projects]
      summary: List all projects
      parameters:
        - name: archived
          in: query
          schema:
            type: boolean
      responses:
        "200":
          description: List of projects
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Project"
    post:
      operationId: createProject
      tags: [projects]
      summary: Create a new project
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProjectInput"
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"

  /projects/{id}:
    get:
      operationId: getProject
      tags: [projects]
      summary: Get a project by ID
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: Project
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"
        "404":
          description: Not found
    patch:
      operationId: updateProject
      tags: [projects]
      summary: Update a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProjectPatch"
      responses:
        "200":
          description: Updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"
        "404":
          description: Not found
    delete:
      operationId: deleteProject
      tags: [projects]
      summary: Delete a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "204":
          description: Deleted
        "404":
          description: Not found

  /projects/{id}/archive:
    patch:
      operationId: archiveProject
      tags: [projects]
      summary: Toggle archive state of a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ArchiveToggle"
      responses:
        "200":
          description: Updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Project"
        "404":
          description: Not found

  /projects/{id}/actors:
    get:
      operationId: listProjectActors
      tags: [projects]
      summary: List actors assigned to a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: List of project-actor assignments
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ProjectActor"
    post:
      operationId: assignActorToProject
      tags: [projects]
      summary: Assign an actor to a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ProjectActorInput"
      responses:
        "201":
          description: Assigned
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProjectActor"

  /projects/{id}/actors/{actorId}:
    delete:
      operationId: removeActorFromProject
      tags: [projects]
      summary: Remove actor from project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
        - name: actorId
          in: path
          required: true
          schema:
            type: number
      responses:
        "204":
          description: Removed
        "404":
          description: Not found

  /projects/{id}/scripts:
    get:
      operationId: listProjectScripts
      tags: [scripts]
      summary: List scripts for a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: List of scripts
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Script"

  /projects/{id}/shots:
    get:
      operationId: listProjectShots
      tags: [shots]
      summary: List shots for a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: List of shots
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Shot"

  /projects/{id}/production-prompt:
    get:
      operationId: getProductionPrompt
      tags: [studio]
      summary: Build an English production prompt from director shots
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: Production prompt
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ProductionPrompt"

  /projects/{id}/tasks:
    get:
      operationId: listProjectTasks
      tags: [tasks]
      summary: List production tasks for a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: List of tasks
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/ProductionTask"

  /projects/{id}/clips:
    get:
      operationId: listProjectClips
      tags: [clips]
      summary: List editing clips for a project
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: List of clips
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/EditClip"

  /scripts/generate:
    post:
      operationId: generateScript
      tags: [scripts]
      summary: Generate a cinematic Arabic script
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ScriptGenerateInput"
      responses:
        "201":
          description: Generated script
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Script"

  /video/generate:
    post:
      operationId: generateVideo
      tags: [studio]
      summary: Generate a cinematic MP4 clip
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/VideoGenerateInput"
      responses:
        "200":
          description: Completed video URL
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/VideoGenerateResponse"
        "502":
          description: Video provider failed or timed out

  /video/stream:
    get:
      operationId: streamVideo
      tags: [studio]
      summary: Stream a generated video through the studio
      parameters:
        - name: url
          in: query
          required: true
          schema:
            type: string
            format: uri
      responses:
        "200":
          description: Video stream
          content:
            video/mp4:
              schema:
                type: string
                format: binary
        "400":
          description: Invalid video URL
        "502":
          description: Video stream unavailable

  /video/download:
    get:
      operationId: downloadVideo
      tags: [studio]
      summary: Download a generated video
      parameters:
        - name: url
          in: query
          required: true
          schema:
            type: string
            format: uri
      responses:
        "200":
          description: Downloadable MP4
          content:
            video/mp4:
              schema:
                type: string
                format: binary
        "400":
          description: Invalid video URL
        "502":
          description: Video download unavailable

  /shots:
    post:
      operationId: createShot
      tags: [shots]
      summary: Create a shot
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ShotInput"
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Shot"

  /shots/{id}:
    patch:
      operationId: updateShot
      tags: [shots]
      summary: Update a shot
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ShotPatch"
      responses:
        "200":
          description: Updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Shot"
    delete:
      operationId: deleteShot
      tags: [shots]
      summary: Delete a shot
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "204":
          description: Deleted

  /tasks:
    post:
