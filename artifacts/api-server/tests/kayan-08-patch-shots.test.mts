/**
 * KAYAN-8: PATCH /api/shots/:id — url validation + audioStatus enum + empty body.
 * Strategy:
 *  - Pure function tests: isValidStorageUrl (single source of truth).
 *  - Zod schema tests: UpdateShotBody (generated by Orval from openapi.yaml).
 *  - HTTP 400-path tests: validation runs BEFORE db call → no DB needed.
 *  - HTTP 200-path (DB roundtrip): documented as env-dependent (skipped in CI).
 */
import express from "express";
import cookieParser from "cookie-parser";
import { UpdateShotBody } from "@workspace/api-zod";
import { isValidStorageUrl } from "../src/routes/shots";

process.env.NODE_ENV = "test";
process.env.DATABASE_URL = process.env.DATABASE_URL || "postgres://x";
process.env.PRODUCTION_API_TOKEN = "test-token";

let passed = 0, failed = 0;
function report(n: string, ok: boolean, x = "") {
  console.log((ok ? "PASS " : "FAIL ") + n + (x ? " :: " + x : ""));
  ok ? passed++ : failed++;
}

// --- 1. isValidStorageUrl (pure) ---
report("U1 null → true", isValidStorageUrl(null) === true);
report("U2 undefined → true", isValidStorageUrl(undefined) === true);
report("U3 /uploads/x → true", isValidStorageUrl("/uploads/videos/x.mp4") === true);
report("U4 /api/storage/x → true", isValidStorageUrl("/api/storage/supabase/videos/x.mp4") === true);
report("U5 https://evil → false", isValidStorageUrl("https://evil.com/x.mp4") === false);
report("U6 data:... → false", isValidStorageUrl("data:video/mp4;base64,AAAA") === false);
report("U7 //evil → false", isValidStorageUrl("//evil.com/x.mp4") === false);
report("U8 empty string → false", isValidStorageUrl("") === false);

// --- 2. Zod UpdateShotBody ---
report("Z1 valid videoUrl accepted", UpdateShotBody.safeParse({ videoUrl: "/uploads/x.mp4" }).success);
report("Z2 null videoUrl accepted", UpdateShotBody.safeParse({ videoUrl: null }).success);
report("Z3 audioStatus COMPLETED accepted", UpdateShotBody.safeParse({ audioStatus: "COMPLETED" }).success);
report("Z4 audioStatus QUEUED accepted", UpdateShotBody.safeParse({ audioStatus: "QUEUED" }).success);
report("Z5 audioStatus GARBAGE rejected", !UpdateShotBody.safeParse({ audioStatus: "GARBAGE" }).success);

// --- 3. HTTP 400 paths (validation before db) ---
async function boot(router: any) {
  const app = express();
  app.use(express.json());
  app.use(cookieParser());
  app.use("/api", router);
  return await new Promise<any>((resolve) => {
    const srv = app.listen(0, () => resolve({ srv, port: (srv.address() as any).port }));
  });
}

async function main() {
  const { default: shotsRouter } = await import("../src/routes/shots");
  const { srv, port } = await boot(shotsRouter);
  const H = { "Content-Type": "application/json", "Authorization": "Bearer test-token" };
  const url = (id: number) => `http://127.0.0.1:${port}/api/shots/${id}`;

  async function patch(id: number, body: any): Promise<{ status: number; body: any }> {
    const r = await fetch(url(id), { method: "PATCH", headers: H, body: JSON.stringify(body) });
    const j = await r.json().catch(() => ({}));
    return { status: r.status, body: j };
  }

  {
    const r = await patch(1, { videoUrl: "https://evil.com/x.mp4" });
    report("H1 external videoUrl → 400 INVALID_URL", r.status === 400 && r.body.error === "INVALID_URL" && r.body.field === "videoUrl");
  }
  {
    const r = await patch(1, { audioUrl: "data:audio/mp3;base64,AAA" });
    report("H2 data: audioUrl → 400 INVALID_URL", r.status === 400 && r.body.error === "INVALID_URL" && r.body.field === "audioUrl");
  }
  {
    const r = await patch(1, { audioStatus: "GARBAGE" });
    report("H3 invalid audioStatus → 400", r.status === 400);
  }
  {
    const r = await patch(1, {});
    report("H4 empty body → 400 NO_FIELDS_TO_UPDATE", r.status === 400 && r.body.error === "NO_FIELDS_TO_UPDATE");
  }

  srv.close();

  // Note: 200-path (DB roundtrip) requires TEST_DATABASE_URL — env-dependent.
  console.log(`\n=== RESULT: ${passed} passed, ${failed} failed ===`);
  process.exit(failed === 0 ? 0 : 1);
}

main().catch((e) => { console.error(e); process.exit(1); });
