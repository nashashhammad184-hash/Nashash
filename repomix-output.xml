                <span className="w-6 h-px bg-sky-500/30" />
                Kayan AI Productions — English Subtitle Track
                <span className="w-6 h-px bg-sky-500/30" />
              </div>
              <pre className="text-sky-100/75 text-sm leading-loose font-mono whitespace-pre-wrap" dir="ltr">
